# FinSight AI - Frontend Environment Variables
# Copy this file to .env.local and configure for your environment

# ============================================================================
# BACKEND API CONFIGURATION
# ============================================================================

# Backend API Base URL (required)
# Development: http://localhost:8000
# Production: https://api.finsight-ai.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# API Version Prefix (default: /api/v1)
NEXT_PUBLIC_API_V1_PREFIX=/api/v1

# ============================================================================
# WEBSOCKET CONFIGURATION
# ============================================================================

# WebSocket URL for real-time fraud alerts and batch processing updates
# Development: ws://localhost:8000
# Production: wss://api.finsight-ai.com
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ============================================================================
# CHROMADB CONFIGURATION
# ============================================================================

# ChromaDB URL (if frontend needs direct vector DB access)
# Development: http://localhost:8001
# Production: https://chromadb.finsight-ai.com
NEXT_PUBLIC_CHROMADB_URL=http://localhost:8001

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable/disable batch transaction processing
NEXT_PUBLIC_ENABLE_BATCH_PROCESSING=true

# Enable/disable agent-based analysis features
NEXT_PUBLIC_ENABLE_AGENT_ANALYSIS=true

# Enable/disable memory system features
NEXT_PUBLIC_ENABLE_MEMORY_SYSTEM=true

# Enable/disable advanced prompting patterns (ReAct, CoT, ToT, etc.)
NEXT_PUBLIC_ENABLE_ADVANCED_PROMPTING=true

# Enable/disable LLM safety checks UI
NEXT_PUBLIC_ENABLE_SAFETY_CHECKS=true

# Enable/disable model routing features
NEXT_PUBLIC_ENABLE_MODEL_ROUTING=true

# ============================================================================
# ANALYTICS & MONITORING (Optional)
# ============================================================================

# Google Analytics ID
# NEXT_PUBLIC_ANALYTICS_ID=G-XXXXXXXXXX

# Sentry DSN for error tracking
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# PostHog API Key for product analytics
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================

# Enable debug mode (shows additional logging and dev tools)
NEXT_PUBLIC_DEBUG_MODE=false

# Log level: error, warn, info, debug
NEXT_PUBLIC_LOG_LEVEL=info

# Mock API mode (for testing without backend)
NEXT_PUBLIC_MOCK_API=false

# API request timeout in milliseconds
NEXT_PUBLIC_API_TIMEOUT=30000

# ============================================================================
# AUTHENTICATION (Optional - for future implementation)
# ============================================================================

# Auth0 Configuration
# NEXT_PUBLIC_AUTH0_DOMAIN=your-tenant.auth0.com
# NEXT_PUBLIC_AUTH0_CLIENT_ID=xxxxx

# NextAuth Configuration
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=your-secret-key

# ============================================================================
# PERFORMANCE & OPTIMIZATION
# ============================================================================

# Enable service worker for offline support
NEXT_PUBLIC_ENABLE_SERVICE_WORKER=false

# Maximum items per page in data tables
NEXT_PUBLIC_MAX_ITEMS_PER_PAGE=50

# Chart data point limit
NEXT_PUBLIC_MAX_CHART_POINTS=100

# ============================================================================
# THEME & UI
# ============================================================================

# Default theme: light, dark, system
NEXT_PUBLIC_DEFAULT_THEME=system

# Enable theme switching
NEXT_PUBLIC_ENABLE_THEME_TOGGLE=true
