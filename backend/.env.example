# Application Settings
APP_NAME=FinSight AI
DEBUG=True
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Concurrency & Performance
MAX_WORKERS=10
TASK_QUEUE_MAX_SIZE=1000
RATE_LIMIT_PER_MINUTE=100
REQUEST_TIMEOUT=60
BATCH_SIZE=100

# Redis (for sessions and caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
SESSION_TTL_SECONDS=3600
# REDIS_PASSWORD=

# ChromaDB (Vector Database for Memory System)
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=./data/chromadb

# Security
SECRET_KEY=dev-secret-key-change-in-production
CORS_ORIGINS=["http://localhost:3000"]

# Logging
LOG_LEVEL=INFO

# MLflow Experiment Tracking (DagsHub Integration)
# For local testing, use local tracking (relative path from backend/)
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=finsight-fraud-detection

# For DagsHub remote tracking (uncomment and add your token):
# Get your token from: https://dagshub.com/user/settings/tokens
# MLFLOW_TRACKING_URI=https://dagshub.com/bibekgupta3333/finsight-ai.mlflow
# MLFLOW_TRACKING_USERNAME=bibekgupta3333
# MLFLOW_TRACKING_PASSWORD=<YOUR_DAGSHUB_TOKEN>

# Model Training Configuration
RANDOM_SEED=42
MAX_TRAINING_SAMPLES=50000  # For M4 Pro memory optimization
MEMORY_LIMIT_GB=16.0
