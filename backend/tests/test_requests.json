          "transaction_id": "TX_MEM_001",
          "fraud_type": "account_drain",
          "risk_level": "HIGH",
          "amount": 181900.0,
          "transaction_type": "CASH_OUT",
          "timestamp": "2026-01-06T10:30:00Z"
