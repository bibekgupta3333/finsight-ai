# FinSight AI - Production Environment Variables
# Copy this file to .env.prod and update with your actual values

# Redis Configuration
REDIS_PASSWORD=changeme-secure-redis-password

# Ollama Configuration (if using external service)
# OLLAMA_BASE_URL=http://ollama:11434

# Backend Configuration
# DEBUG=False
# LOG_LEVEL=INFO
# WORKERS=4

# Security
# SECRET_KEY=changeme-secret-key-for-jwt
# ALLOWED_HOSTS=finsight-ai.example.com,api.finsight-ai.example.com

# Database (if using PostgreSQL instead of file storage)
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=finsight
# DB_USER=finsight
# DB_PASSWORD=changeme-db-password

# Monitoring
# SENTRY_DSN=https://your-sentry-dsn
# PROMETHEUS_ENABLED=true

# Rate Limiting
# RATE_LIMIT_PER_MINUTE=100
# RATE_LIMIT_PER_HOUR=1000
